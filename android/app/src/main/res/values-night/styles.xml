<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night theme: black launch splash (bg + centered logo), light status-bar
         icons. Mirrors the dashboard dark theme (#0b0d10). -->
    <style name="Theme.Single" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">#0A84FF</item>
        <item name="android:colorAccent">#0A84FF</item>
    </style>
</resources>
