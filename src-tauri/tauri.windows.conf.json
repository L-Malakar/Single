{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Single — one room, one network",
        "url": "index.html",
        "width": 1160,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
